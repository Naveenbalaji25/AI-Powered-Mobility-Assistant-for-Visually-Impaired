# software/gps_module.py

```python
import serial


def get_location():
    try:
        gps = serial.Serial('/dev/ttyUSB0', baudrate=9600, timeout=1)

        data = gps.readline().decode('utf-8', errors='ignore')

        return data

    except:
        return "GPS Not Available"
```

