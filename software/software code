# AI-Powered Mobility Assistant for Visually Impaired

## software/main.py

```python
import cv2
from yolo_detection import detect_objects
from ocr_reader import extract_text
from gps_module import get_location
from voice_output import speak

camera = cv2.VideoCapture(0)

print("AI Mobility Assistant Started...")

while True:
    ret, frame = camera.read()

    if not ret:
        break

    # Object Detection
    detected_objects = detect_objects(frame)

    for obj in detected_objects:
        label = obj['label']
        confidence = obj['confidence']

        print(f"Detected: {label} ({confidence:.2f})")

        if confidence > 0.5:
            speak(f"Detected {label}")

    # OCR Detection
    extracted_text = extract_text(frame)

    if extracted_text.strip() != "":
        print("OCR Text:", extracted_text)
        speak(extracted_text[:100])

    # GPS Location
    location = get_location()

    if location:
        print("Location:", location)

    # Display Output Window
    cv2.imshow("AI Mobility Assistant", frame)

    key = cv2.waitKey(1)

    if key == 27:
        break

camera.release()
cv2.destroyAllWindows()
```

